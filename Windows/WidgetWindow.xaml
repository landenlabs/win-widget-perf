<Window x:Class="WinWidgetPerf.Windows.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="340" Height="160"
        MinWidth="160" MinHeight="80"
        Title="Performance Widget">

    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DriveButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="15"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Foreground" Value="#CCCDD6F4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#88FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Background="#FF1E1E2E" BorderBrush="#FF454570">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#FFCDD6F4"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="📊  Resource Monitor" Click="ResourceMonitor_Click"/>
            <MenuItem Header="⚙  Settings"          Click="Settings_Click"/>
            <MenuItem Header="?  About"             Click="About_Click"/>
            <Separator Background="#FF454570"/>
            <MenuItem x:Name="RemoveMenuItem"
                      Header="✕  Remove Widget"     Click="Remove_Click"/>
            <Separator Background="#FF454570"/>
            <MenuItem Header="✕  Exit"              Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="WidgetBorder"
            Background="#CC1E1E2E"
            BorderBrush="#FF454570"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10"
            Cursor="SizeAll"
            MouseLeftButtonDown="Widget_MouseLeftButtonDown"
            MouseMove="Widget_MouseMove"
            MouseLeftButtonUp="Widget_MouseLeftButtonUp"
            MouseEnter="Widget_MouseEnter"
            MouseLeave="Widget_MouseLeave">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Title -->
                <RowDefinition Height="*"/>      <!-- Chart + disk-space bar -->
                <RowDefinition Height="Auto"/>   <!-- Drive selector -->
            </Grid.RowDefinitions>

            <!-- Title section (collapses as a unit) -->
            <StackPanel x:Name="TitleSection" Grid.Row="0" Orientation="Vertical">
                <Grid Height="20" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText"
                               Grid.Column="0"
                               FontSize="11"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False">
                        <Run Text="📈 Performance" Foreground="#AAFFFFFF"/>
                    </TextBlock>
                    <StackPanel x:Name="IconPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                IsHitTestVisible="True">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="📊"
                                ToolTip="Resource Monitor"
                                Click="ResourceMonitor_Click"/>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="⚙"
                                ToolTip="Settings"
                                Click="Settings_Click"/>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="?"
                                ToolTip="About"
                                FontWeight="Bold"
                                Margin="3,0,0,0"
                                Click="About_Click"/>
                    </StackPanel>
                </Grid>
                <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,0,0,6" IsHitTestVisible="False"/>
            </StackPanel>

            <!-- Chart + optional right-side disk-space bar -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>     <!-- Chart -->
                    <ColumnDefinition Width="Auto"/>  <!-- Disk-space bar -->
                </Grid.ColumnDefinitions>

                <Border x:Name="ChartBorder"
                        Grid.Column="0"
                        Background="#FF0D0D1A"
                        CornerRadius="4"
                        ClipToBounds="True">
                    <Grid>
                        <Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged"/>

                        <!-- Legend overlay -->
                        <StackPanel x:Name="LegendPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="6,4"
                                    IsHitTestVisible="False">
                            <Ellipse x:Name="CpuDot" Width="8" Height="8" Fill="#FF89B4FA"
                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="CpuLegend" Text="CPU --%"
                                       Foreground="#FFCDD6F4" FontSize="10"
                                       FontFamily="Consolas, Courier New"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Ellipse x:Name="DiskDot" Width="8" Height="8" Fill="#FFF9A825"
                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="DiskLegend" Text="C: --%"
                                       Foreground="#FFCDD6F4" FontSize="10"
                                       FontFamily="Consolas, Courier New"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Ellipse x:Name="NetDot" Width="8" Height="8" Fill="#FFA6E3A1"
                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="NetLegend" Text="Net --%"
                                       Foreground="#FFCDD6F4" FontSize="10"
                                       FontFamily="Consolas, Courier New"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Disk-space bar (right side, narrow vertical fill) -->
                <Border x:Name="DiskSpaceBarBorder"
                        Grid.Column="1"
                        Width="12"
                        Margin="4,0,0,0"
                        Background="#FF0D0D1A"
                        CornerRadius="3"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                    <Canvas x:Name="DiskSpaceCanvas"
                            SizeChanged="DiskSpaceCanvas_SizeChanged"/>
                </Border>
            </Grid>

            <!-- Drive selector row -->
            <WrapPanel x:Name="DriveSelectorPanel"
                       Grid.Row="2"
                       Orientation="Horizontal"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
