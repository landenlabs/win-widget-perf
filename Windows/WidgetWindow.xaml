<Window x:Class="WinWidgetPerf.Windows.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="340" Height="160"
        MinWidth="160" MinHeight="80"
        Title="Performance Widget">

    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Background="#FF1E1E2E" BorderBrush="#FF454570">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#FFCDD6F4"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="📊  Resource Monitor" Click="ResourceMonitor_Click"/>
            <MenuItem Header="⚙  Settings"          Click="Settings_Click"/>
            <MenuItem Header="?  About"             Click="About_Click"/>
            <Separator Background="#FF454570"/>
            <MenuItem x:Name="RemoveMenuItem"
                      Header="✕  Remove Widget"     Click="Remove_Click"/>
            <Separator Background="#FF454570"/>
            <MenuItem Header="✕  Exit"              Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="WidgetBorder"
            Background="#CC1E1E2E"
            BorderBrush="#FF454570"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10"
            Cursor="SizeAll"
            MouseLeftButtonDown="Widget_MouseLeftButtonDown"
            MouseMove="Widget_MouseMove"
            MouseLeftButtonUp="Widget_MouseLeftButtonUp"
            MouseEnter="Widget_MouseEnter"
            MouseLeave="Widget_MouseLeave">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Title -->
                <RowDefinition Height="*"/>      <!-- Chart -->
            </Grid.RowDefinitions>

            <!-- Title section (collapses as a unit) -->
            <StackPanel x:Name="TitleSection" Grid.Row="0" Orientation="Vertical">
                <Grid Height="20" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText"
                               Grid.Column="0"
                               Text="📈 Performance"
                               Foreground="#AAFFFFFF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBlock x:Name="ProcText"
                               Grid.Column="1"
                               Text=""
                               Foreground="#FFE6B860"
                               FontSize="11"
                               Margin="8,0,6,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="IconPanel"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                IsHitTestVisible="True">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="📊"
                                ToolTip="Resource Monitor"
                                Click="ResourceMonitor_Click"/>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="⚙"
                                ToolTip="Settings"
                                Click="Settings_Click"/>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="?"
                                ToolTip="About"
                                FontWeight="Bold"
                                Margin="3,0,0,0"
                                Click="About_Click"/>
                    </StackPanel>
                </Grid>
                <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,0,0,6" IsHitTestVisible="False"/>
            </StackPanel>

            <!-- Chart -->
            <Border x:Name="ChartBorder"
                    Grid.Row="1"
                    Background="#FF0D0D1A"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged"/>

                    <!-- Legend overlay -->
                    <StackPanel x:Name="LegendPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6,4"
                                IsHitTestVisible="False">
                        <Ellipse x:Name="CpuDot" Width="8" Height="8" Fill="#FF89B4FA"
                                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="CpuLegend" Text="CPU --%"
                                   Foreground="#FFCDD6F4" FontSize="10"
                                   FontFamily="Consolas, Courier New"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Ellipse x:Name="DiskDot" Width="8" Height="8" Fill="#FFF9A825"
                                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="DiskLegend" Text="C: Q --"
                                   Foreground="#FFCDD6F4" FontSize="10"
                                   FontFamily="Consolas, Courier New"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Resize grip -->
                    <Path x:Name="ResizeGrip"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,1,1"
                          Fill="#66FFFFFF"
                          Cursor="SizeNWSE"
                          Data="M 12,0 L 12,12 L 0,12 Z"
                          ToolTip="Drag to resize"
                          MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                          MouseMove="ResizeGrip_MouseMove"
                          MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
