<Window x:Class="WinWidgetPerf.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinWidgetPerf — Settings"
        Width="520"
        MinWidth="480"
        Height="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FF181825"
        Foreground="#FFCDD6F4"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>   <!-- Separator -->
            <RowDefinition Height="Auto"/>   <!-- Buttons -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Widget Appearance -->
                <Border Background="#FF1E1E2E" Margin="16,16,16,0" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Widget Appearance"
                                   Foreground="#FF89B4FA" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,0,0,16"/>

                        <!-- Background color -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Background:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="120"/>
                            <Border Width="42" Height="28" CornerRadius="4"
                                    Background="{Binding BgColorBrush}"
                                    BorderBrush="#FF454570" BorderThickness="1"
                                    Cursor="Hand" Margin="0,0,12,0"
                                    MouseLeftButtonDown="BgColorSwatch_Click"/>
                            <Button Content="Change…" Style="{StaticResource SubtleButton}" Padding="10,5"
                                    Click="BgColorSwatch_Click"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="#FF6C7086" FontSize="11" FontFamily="Consolas, Courier New"
                                       Text="{Binding BgColorHex}"/>
                        </StackPanel>

                        <!-- Chart background color -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Chart Background:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="120"/>
                            <Border Width="42" Height="28" CornerRadius="4"
                                    Background="{Binding ChartBgColorBrush}"
                                    BorderBrush="#FF454570" BorderThickness="1"
                                    Cursor="Hand" Margin="0,0,12,0"
                                    MouseLeftButtonDown="ChartBgColorSwatch_Click"/>
                            <Button Content="Change…" Style="{StaticResource SubtleButton}" Padding="10,5"
                                    Click="ChartBgColorSwatch_Click"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="#FF6C7086" FontSize="11" FontFamily="Consolas, Courier New"
                                       Text="{Binding ChartBgColorHex}"/>
                        </StackPanel>

                        <!-- CPU line color -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="CPU Line:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="120"/>
                            <Border Width="42" Height="28" CornerRadius="4"
                                    Background="{Binding CpuColorBrush}"
                                    BorderBrush="#FF454570" BorderThickness="1"
                                    Cursor="Hand" Margin="0,0,12,0"
                                    MouseLeftButtonDown="CpuColorSwatch_Click"/>
                            <Button Content="Change…" Style="{StaticResource SubtleButton}" Padding="10,5"
                                    Click="CpuColorSwatch_Click"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="#FF6C7086" FontSize="11" FontFamily="Consolas, Courier New"
                                       Text="{Binding CpuColorHex}"/>
                        </StackPanel>

                        <!-- Disk line color -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Disk Line:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="120"/>
                            <Border Width="42" Height="28" CornerRadius="4"
                                    Background="{Binding DiskColorBrush}"
                                    BorderBrush="#FF454570" BorderThickness="1"
                                    Cursor="Hand" Margin="0,0,12,0"
                                    MouseLeftButtonDown="DiskColorSwatch_Click"/>
                            <Button Content="Change…" Style="{StaticResource SubtleButton}" Padding="10,5"
                                    Click="DiskColorSwatch_Click"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="#FF6C7086" FontSize="11" FontFamily="Consolas, Courier New"
                                       Text="{Binding DiskColorHex}"/>
                        </StackPanel>

                        <!-- Network line color -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Network Line:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="120"/>
                            <Border Width="42" Height="28" CornerRadius="4"
                                    Background="{Binding NetColorBrush}"
                                    BorderBrush="#FF454570" BorderThickness="1"
                                    Cursor="Hand" Margin="0,0,12,0"
                                    MouseLeftButtonDown="NetColorSwatch_Click"/>
                            <Button Content="Change…" Style="{StaticResource SubtleButton}" Padding="10,5"
                                    Click="NetColorSwatch_Click"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="#FF6C7086" FontSize="11" FontFamily="Consolas, Courier New"
                                       Text="{Binding NetColorHex}"/>
                        </StackPanel>

                        <!-- Opacity -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Opacity:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="120"/>
                            <Slider x:Name="OpacitySlider" Width="150" Minimum="0" Maximum="100"
                                    Value="{Binding BgOpacityPercent, Mode=TwoWay}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Margin="12,0,0,0" Width="40" VerticalAlignment="Center"
                                       Foreground="#FF89B4FA" FontWeight="SemiBold"
                                       Text="{Binding BgOpacityPercent, StringFormat={}{0}%}"/>
                        </StackPanel>

                        <!-- Font scale -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Font Scale:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="120"/>
                            <Slider x:Name="FontScaleSlider" Width="150" Minimum="50" Maximum="200"
                                    Value="{Binding FontScalePercent, Mode=TwoWay}"
                                    TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Margin="12,0,0,0" Width="44" VerticalAlignment="Center"
                                       Foreground="#FF89B4FA" FontWeight="SemiBold"
                                       Text="{Binding FontScalePercent, StringFormat={}{0}%}"/>
                        </StackPanel>

                        <!-- Embed -->
                        <CheckBox Content="Embed in wallpaper layer (restart required)"
                                  IsChecked="{Binding EmbedInWallpaper, Mode=TwoWay}"
                                  Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,4,0,0"/>

                        <!-- Auto-start -->
                        <CheckBox x:Name="AutoStartCheck" Content="Auto-start on login"
                                  IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                  Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Chart Settings -->
                <Border Background="#FF1E1E2E" Margin="16,8,16,0" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Chart Settings"
                                   Foreground="#FF89B4FA" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,0,0,16"/>

                        <!-- Disk drive -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Disk Drive:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="140"/>
                            <ComboBox x:Name="DriveCombo" Width="90"
                                      ItemsSource="{Binding Drives}"
                                      SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- Duration -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Chart Duration:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="140"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Width="80"
                                     Text="{Binding DurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FF6C7086" FontSize="11"
                                       Text="{Binding DurationHint}"/>
                        </StackPanel>

                        <!-- Disk queue scale -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Disk Queue Max:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="140"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Width="80"
                                     Text="{Binding DiskQueueScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FF6C7086" FontSize="11"
                                       Text="queue length mapped to full height"/>
                        </StackPanel>

                        <!-- Update interval -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Sample Interval:" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="140"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Width="80"
                                     Text="{Binding UpdateInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FF6C7086" FontSize="11" Text="ms"/>
                        </StackPanel>

                        <!-- Size -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="Size (W × H):" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="0,0,12,0" Width="140"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Width="70"
                                     Text="{Binding WidgetWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="×" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="8,0,8,0"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Width="70"
                                     Text="{Binding WidgetHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FF6C7086" FontSize="11"
                                       Text="px (or drag the corner grip)"/>
                        </StackPanel>

                        <!-- Show toggles -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox Content="Title" IsChecked="{Binding ShowTitle, Mode=TwoWay}"
                                      Foreground="#FFA6ADC8" Margin="0,0,20,0"/>
                            <CheckBox Content="Legend" IsChecked="{Binding ShowLegend, Mode=TwoWay}"
                                      Foreground="#FFA6ADC8" Margin="0,0,20,0"/>
                            <CheckBox Content="Grid Lines" IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                                      Foreground="#FFA6ADC8" Margin="0,0,20,0"/>
                            <CheckBox Content="Network" IsChecked="{Binding ShowNetwork, Mode=TwoWay}"
                                      Foreground="#FFA6ADC8"/>
                        </StackPanel>
                        <CheckBox Content="Show busiest process in title (rolling CPU average)"
                                  IsChecked="{Binding ShowTopProcess, Mode=TwoWay}"
                                  Foreground="#FFA6ADC8" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Position Picker -->
                <Border Background="#FF1E1E2E" Margin="16,8,16,16" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Widget Position"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#FF89B4FA"
                                       VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#FF454570" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding WidgetPositionText}"
                                       FontSize="11" Foreground="#FF6C7086"
                                       FontFamily="Consolas, Courier New" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="ScreenMapCanvas" Height="110" Background="#FF0D0D1A" ClipToBounds="True"/>
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#FF6C7086"
                                   Text="Drag the blue marker to reposition the widget — it moves live."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Rectangle Grid.Row="1" Height="1" Fill="#FF454570" Margin="16,8,16,8"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16">
            <Button Content="Cancel" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK"     Style="{StaticResource AccentButton}" Click="OK_Click"/>
        </StackPanel>
    </Grid>
</Window>
